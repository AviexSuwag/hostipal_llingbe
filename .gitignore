# ============================================================
# Node / npm
# ============================================================
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.npmrc.local

# ============================================================
# Composer dependencies
# ============================================================
/vendor/

# ============================================================
# Tailwind CSS build output
# (source lives in assets/css/tailwind.css; regenerate with
#  `npm run tailwind:build`. Remove this line if you prefer to
#  commit the compiled file.)
# ============================================================
/assets/css/app.css
/assets/css/app.css.map

# ============================================================
# Browser vendor copies
# (regenerated from npm dependencies by the postinstall script)
# ============================================================
/assets/js/vendor/axios.min.js
/assets/js/vendor/sweetalert2.all.min.js
/assets/css/sweetalert2.min.css

# ============================================================
# Environment / secrets / local config
# ============================================================
.env
.env.*
!.env.example
/config/config.local.php
/config/connection.local.php

# ============================================================
# Logs & runtime artifacts
# ============================================================
*.log
/logs/
/tmp/
/temp/
/cache/

# ============================================================
# Uploads & user-generated content
# (keep the folders, ignore their contents)
# ============================================================
/uploads/*
!/uploads/.gitkeep
/storage/*
!/storage/.gitkeep

# ============================================================
# SQL dumps, backups, exports
# (keep the schema file, ignore ad-hoc backups)
# ============================================================
*.sql.bak
*.sql.gz
*.sql.zip
/backups/
/db-dumps/

# ============================================================
# Editor / IDE
# ============================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.iml
*.sublime-project
*.sublime-workspace
.project
.settings/
*.swp
*.swo
*~

# ============================================================
# OS files
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ============================================================
# XAMPP / Apache / PHP local artifacts
# ============================================================
.htaccess.local
php_errorlog
php_errors.log
/error_log
/access_log

# ============================================================
# Test / coverage
# ============================================================
/coverage/
.phpunit.result.cache
.php-cs-fixer.cache
phpcs.xml.bak